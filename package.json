{
  "name": "@bushizhanghan/dsh-workspace-switch-cost",
  "version": "0.1.0",
  "description": "Quantify what switching projects costs: the cold-start context every workspace charges on entry (AGENTS.md + skill catalog + tool schemas + runtime snapshot), how many turns until the session reaches steady state, and which workspaces to keep warm vs archive. Deterministic, read-only, no LLM. 量化切换工作区的真实代价：入场冷启动上下文、进入稳态所需的轮数、该保温还是归档。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./engine": "./lib/engine.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "workspace",
    "context",
    "cold-start",
    "switching-cost",
    "audit",
    "agent-tools"
  ],
  "author": "bushizhanghan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bushizhanghan/dsh-workspace-switch-cost.git"
  },
  "bugs": {
    "url": "https://github.com/bushizhanghan/dsh-workspace-switch-cost/issues"
  },
  "homepage": "https://github.com/bushizhanghan/dsh-workspace-switch-cost#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/"
  }
}
